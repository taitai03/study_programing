<% content_for :title, "ログイン" %>
<main class="login">
  <h1>さくらマート 管理画面</h1>
  <% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>

  <%= form_with url: session_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "メールアドレス" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password, "パスワード" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <%= form.submit "ログイン", class: "button" %>
  <% end %>

  <p class="muted small">開発用のアカウント: admin@sakura-mart.example / password（bin/rails db:seed で作成）</p>
</main>
