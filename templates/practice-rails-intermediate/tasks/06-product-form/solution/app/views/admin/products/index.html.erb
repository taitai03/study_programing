<% content_for :title, "商品" %>
<div class="actions">
  <h1>商品</h1>
  <%= link_to "商品を登録する", new_admin_product_path, class: "button" %>
</div>
<p class="muted"><%= @products.size %>件</p>

<table class="table">
  <thead>
    <tr><th>ID</th><th>商品名</th><th>カテゴリ</th><th class="num">価格（税抜）</th><th class="num">在庫</th><th>公開</th><th></th></tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.id %></td>
        <td><%= product.name %></td>
        <td><%= product.category.name %></td>
        <td class="num"><%= yen(product.price) %></td>
        <td class="num"><%= product.stock %></td>
        <td><%= product.published? ? tag.span("公開", class: "badge badge-completed") : tag.span("非公開", class: "badge") %></td>
        <td class="actions">
          <%= link_to "編集", edit_admin_product_path(product) %>
          <% if product.published? %>
            <%= button_to "非公開にする", unpublish_admin_product_path(product), method: :patch, class: "button button-outline",
                          form: { data: { turbo_confirm: "「#{product.name}」を非公開にしますか？" } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
