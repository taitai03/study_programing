# DB（ローカルは docker compose で起動するPostgreSQL）
DATABASE_URL=postgres://study:study@localhost:5433/study_programing

# Better Auth
BETTER_AUTH_SECRET=   # openssl rand -base64 32 で生成
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App（https://github.com/settings/developers で作成）
# コールバックURL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 最初の管理者のGitHubユーザー名（許可リストに未登録でもログインでき、管理者になる）
INITIAL_ADMIN_GITHUB_LOGIN=

# 開発用ログイン（GitHub OAuth Appなしで動作確認するためのもの。本番では使えない）
DEV_LOGIN=false
DEV_LOGIN_PASSWORD=
