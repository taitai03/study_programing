# DB（ローカルは docker compose で起動するPostgreSQL）
DATABASE_URL=postgres://study:study@localhost:5433/study_programing

# Better Auth
BETTER_AUTH_SECRET=   # openssl rand -base64 32 で生成
BETTER_AUTH_URL=http://localhost:3000

# GitHub App（設定のしかたは docs/github-app.md）
# ログイン: App の Client ID と Client secret（コールバックURL: http://localhost:3000/api/auth/callback/github）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 課題リポジトリとの連携: App ID、URL の slug、秘密鍵（PEM。改行は \n と書いてよい）、Webhook の secret
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub API の URL（省略すると https://api.github.com。GitHub Enterprise やテスト用の偽のAPIに向けるときだけ設定する）
# GITHUB_API_URL=

# 最初の管理者のGitHubユーザー名（許可リストに未登録でもログインでき、管理者になる）
INITIAL_ADMIN_GITHUB_LOGIN=

# 開発用ログイン（GitHub なしで動作確認するためのもの。本番では使えない）。パスワードは8文字以上
DEV_LOGIN=false
DEV_LOGIN_PASSWORD=
